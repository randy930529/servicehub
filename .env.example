# Base URL of the ServiceHub backend (server/).
# Defaults to http://localhost:3000 in code — works for web and the iOS simulator.
# Android emulator:  http://10.0.2.2:3000
# Physical device:   http://<your-LAN-IP>:3000   (e.g. http://192.168.1.20:3000)
EXPO_PUBLIC_API_URL=http://localhost:3000

# Host baked into MinIO's presigned upload URLs. Docker Compose reads this file,
# so setting it here is what the `server` container uses.
#
# It has to match EXPO_PUBLIC_API_URL's host: the app PUTs images (avatars and
# service photos) straight to storage, so if the API is reachable at 10.0.2.2
# and this still says localhost, uploads fail from the emulator even though
# every other request works.
#   iOS simulator / web : http://localhost:9000
#   Android emulator    : http://10.0.2.2:9000
#   Physical device     : http://<your-LAN-IP>:9000
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
