# MongoDB connection string (inline connection — no Docker).
# Local mongod:
NEXT_MONGODB_URI=mongodb://127.0.0.1:27017/servicehub
# Or MongoDB Atlas:
# NEXT_MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/servicehub?retryWrites=true&w=majority

# Secret used to sign access JWTs (HS256). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
NEXT_JWT_SECRET=replace-me-with-a-long-random-secret

# Token lifetimes (optional — these are the defaults).
# NEXT_JWT_ACCESS_TTL_SECONDS=900
# NEXT_REFRESH_TOKEN_TTL_DAYS=30

# Pagination defaults for GET /api/services (optional — these are the defaults).
# NEXT_DEFAULT_PAGE=1
# NEXT_DEFAULT_LIMIT=10
# NEXT_MAX_LIMIT=100

# ---------------------------------------------------------------------------
# Image storage (S3-compatible). `docker compose up` runs MinIO with these
# defaults; point them at a real S3 bucket to switch providers — no code change.
# ---------------------------------------------------------------------------

# Where the *server* reaches storage. Under docker compose this is overridden
# to http://minio:9000 (the compose service name).
NEXT_S3_ENDPOINT=http://localhost:9000

# Host baked into the presigned upload URL — it must be reachable **from the
# device**, because the app PUTs the file directly here. SigV4 signs the Host
# header, so a URL signed for one host cannot be used against another.
#   iOS simulator / web : http://localhost:9000
#   Android emulator    : http://10.0.2.2:9000
#   Physical device     : http://<your-LAN-IP>:9000
# Leave unset to fall back to NEXT_S3_ENDPOINT.
NEXT_S3_PUBLIC_ENDPOINT=http://localhost:9000

NEXT_S3_BUCKET=avatars
NEXT_S3_ACCESS_KEY_ID=servicehub
NEXT_S3_SECRET_ACCESS_KEY=servicehub-dev-secret

# MinIO ignores the region but the AWS SDK requires one to sign requests.
# NEXT_S3_REGION=us-east-1

# Path-style URLs (http://host/bucket/key). Required by MinIO; set to false
# for real AWS S3, which uses virtual-hosted style.
# NEXT_S3_FORCE_PATH_STYLE=true

# How long a presigned upload URL stays valid, in seconds (default 300).
# NEXT_S3_UPLOAD_URL_TTL_SECONDS=300

# Max avatar size accepted by the API, in bytes (default 5 MB).
# NEXT_AVATAR_MAX_BYTES=5242880

# Bucket for service photos. Separate from avatars so the two can have
# different retention/quota policies (default "service-images").
NEXT_S3_SERVICE_IMAGES_BUCKET=service-images

# Only needed on real S3 with virtual-hosted URLs, where each bucket has its own
# host. With MinIO (path style) the shared public endpoint already covers it.
# NEXT_S3_SERVICE_IMAGES_PUBLIC_ENDPOINT=https://service-images.s3.amazonaws.com

# Max service image size accepted by the API, in bytes (default 5 MB).
# NEXT_SERVICE_IMAGE_MAX_BYTES=5242880

# ---------------------------------------------------------------------------
# Push notifications (Expo Push Service). See docs/notifications/push.md.
# ---------------------------------------------------------------------------

# Only needed if you turn on "enhanced push security" in the Expo dashboard:
# without it, sends are rejected. It's what stops a leaked push token from
# letting anyone impersonate this server.
# EXPO_ACCESS_TOKEN=
